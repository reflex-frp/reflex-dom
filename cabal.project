packages:
  reflex-dom-core/
  reflex-dom/

if os(linux) && arch(x86_64)
  packages:
    chrome-test-utils/
    reflex-dom-test-selenium/

if os(linux) || os(osx)
   tests: true
   benchmarks: true

package reflex-dom
  flags: +use-warp -webkit2gtk +build-examples



if impl(ghc == 9.14.*)
  allow-newer:
      *:base
    , *:template-haskell
    , *:ghc-experimental
    , *:ghc-internal
    , patch:containers
    , parser-regex:ghc-bignum
  constraints:
      base < 4.23
    , template-haskell < 2.25
    , ghc-experimental < 9.1500
    , ghc-internal < 9.1500

if arch(wasm32)
  shared: True
  allow-newer:
      *:*
    , *:time
  constraints:
    , time >= 1.15
