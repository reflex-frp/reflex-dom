packages:
  reflex-dom-core/
  reflex-dom/

if os(linux) && arch(x86_64)
  packages:
    chrome-test-utils/
    reflex-dom-test-selenium/

if os(linux) || os(osx)
   tests: true
   benchmarks: true

package reflex-dom
  flags: +build-examples

-- https://github.com/haskellari/splitmix/pull/73
-- https://github.com/haskellari/splitmix/pull/75
source-repository-package
  type: git
  location: https://github.com/alexfmpe/splitmix
  tag: bd53859c0f41d12f16c3f44fee52f5e9aae26243

-- https://github.com/ghcjs/jsaddle/pull/172
source-repository-package
  type: git
  location: https://github.com/obsidiansystems/jsaddle.git
  tag: 2152422657602dc29c89140cebd3d7fae080acf1
  subdir: jsaddle-warp
  post-checkout-command: npm ci --ignore-scripts --prefix jsaddle-warp/node-client
